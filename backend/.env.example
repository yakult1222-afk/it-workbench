# 后端环境变量模板
# 用法：复制为 backend/.env 后按需修改（.env 已被 .gitignore 排除，不会提交到仓库）
#   cp backend/.env.example backend/.env
# 启动时会自动加载：./scripts/start-backend.sh
# 不创建 .env 也能跑——此时全部走 application.yml 里的默认值

# ---------- 数据库 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=it_workbench
MYSQL_USER=root
MYSQL_PASSWORD=root123456

# ---------- 日报总结 AI（OpenAI 兼容协议）----------
# 留空 AI_API_KEY = 不调用 AI，日报走模板汇总
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# ---------- PC 硬件资讯 RSS 源（逗号分隔，按顺序尝试）----------
# WORKBENCH_NEWS_SOURCES=https://www.ithome.com/rss/,https://rss.mydrivers.com/
