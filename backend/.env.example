# 后端环境变量模板
# 用法：复制为 backend/.env 后按需修改（.env 已被 .gitignore 排除，不会提交到仓库）
#   cp backend/.env.example backend/.env
# 启动时会自动加载：./scripts/start-backend.sh
# 不创建 .env 也能跑——此时全部走 application.yml 里的默认值

# ---------- 数据库 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=it_workbench
MYSQL_USER=root
MYSQL_PASSWORD=root123456

# ---------- Redis（日报缓存，可选但推荐）----------
# Redis 不可用时后端的日报会回退 MySQL，不会整体失败
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT_MS=2000
AI_SUMMARY_CACHE_TTL_SECONDS=1800

# ---------- AI 日报异步 Worker ----------
AI_SUMMARY_WORKER_ENABLED=true
AI_SUMMARY_POLL_INTERVAL_MS=1000
AI_SUMMARY_CONCURRENCY=2
AI_SUMMARY_LEASE_SECONDS=120
AI_SUMMARY_MAX_ATTEMPTS=3
AI_SUMMARY_RETRY_DELAYS_SECONDS=5,20,60

# ---------- 登录与权限 ----------
JWT_SECRET=replace-with-at-least-32-byte-secret-value
JWT_EXPIRE_HOURS=8
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ---------- 日报总结 AI（OpenAI 兼容协议）----------
# 留空 AI_API_KEY = 不调用 AI，日报走模板汇总
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# ---------- PC 硬件资讯 RSS 源（逗号分隔，按顺序尝试）----------
# WORKBENCH_NEWS_SOURCES=https://www.ithome.com/rss/,https://rss.mydrivers.com/
